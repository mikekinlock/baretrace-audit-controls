# Terraform
**/.terraform/
**/.terraform-build/
*.tfstate
*.tfstate.*
*.tfplan
plan.json
.terraform.lock.hcl.bak

# Local tfvars overrides could carry an address or credential, so they stay out
# of git.
*.tfvars
*.auto.tfvars
# Except these two: they carry no address (only alert_subscription_enabled) and
# are committed.
!terraform/variables/*.tfvars

# Build output
build/

# Credentials — belt and braces, these should never be in the tree
.env
.env.*
*.pem

# macOS
.DS_Store
